{
  "format": 1,
  "repositories": {
    "app": "app",
    "kernel": "kernel",
    "platform": "platform"
  },
  "display": {
    "width": 448,
    "height": 368,
    "cjk_font": true
  },
  "keys": {
    "names": [
      "POWER",
      "BACK",
      "PREV",
      "NEXT",
      "PLAY"
    ],
    "single_min_ms": 20,
    "double_gap_ms": 300,
    "long_press_ms": 800
  },
  "components": {
    "display": true,
    "storage": true,
    "keys": true,
    "apps": true,
    "sqlite": false,
    "usb": false,
    "audio": false,
    "wireless": false,
    "data": true,
    "network": true
  },
  "logging": {
    "enabled": true,
    "level": "info"
  },
  "web": {
    "enabled": true,
    "port": 8765
  },
  "app": {
    "startup": "homepage",
    "grants": [
      "system.info",
      "display.ui",
      "display.text",
      "storage.private",
      "apps.list",
      "apps.launch",
      "apps.navigate",
      "appearance.read",
      "appearance.write",
      "input.keys",
      "system.log",
      "storage.database",
      "system.ui.read",
      "system.settings",
      "system.lifecycle",
      "screensaver.inhibit",
      "data.read",
      "power.read",
      "wireless.read",
      "clock.read",
      "network.http"
    ]
  },
  "system_ui": {
    "status_bar": true,
    "status_bar_height": 32,
    "screensaver": false,
    "idle_timeout_ms": 30000,
    "clock_move_interval_ms": 10000,
    "lock_enabled": false,
    "status_left": "{time}",
    "status_right": "{wifi} {bt} {ble} {battery}",
    "saver_text": "{time}",
    "unlock_key": "POWER",
    "unlock_action": 2
  }
}
